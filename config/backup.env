# ==============================================================================
# CompNova Lean GitHub Security & Automated Backup - Global Configuration
# ==============================================================================

# GLOBAL VARIABLE: S3 Storage Bucket URL (Edit this value to point to your S3 vault)
S3_BUCKET_URL="s3://compnova-git-immutable-vault"

# AWS & Encryption Settings
AWS_REGION="us-east-1"
SSE_ALGORITHM="AES256"
# Optional KMS Key ID if SSE_ALGORITHM="aws:kms"
SSE_KMS_KEY_ID=""

# S3 Object Lock Compliance Settings (Slide 2: Immutable Vault / Slide 3: Locked Storage)
ENABLE_OBJECT_LOCK="true"
OBJECT_LOCK_MODE="COMPLIANCE"
OBJECT_LOCK_RETENTION_DAYS="90"

# Repository & Compliance Settings (Slide 2: Access, Privacy & Branch Protection)
GITHUB_ORG="compnova"
GITHUB_REPO="compnova/sap-server"
GITHUB_REPO_URL="git@github.com:compnova/sap-server.git"

# Every branch that the GitHub workflows trigger on (push / pull_request) AND
# that branch protection must cover. Space or comma separated. Keep this list
# in sync with .github/workflows/*.yml - verify_repo_compliance.sh --audit-only
# reports FAIL (drift) when the two diverge.
PROTECTED_BRANCHES="main master production"
# Primary/default branch. Kept for backward compatibility: used by scripts and
# workflows as the fallback single branch when PROTECTED_BRANCHES is unset.
PROTECTED_BRANCH="main"
GITHUB_REVIEW_TEAM_SLUG="core-reviewers"
REQUIRED_APPROVING_REVIEWS="1"

# Path B: Repositories Mirrored (space, comma or newline separated owner/repo
# entries). Scale Path B across repos by adding entries here - no code change.
GITHUB_REPO_LIST="compnova/sap-server"

# Path B: Out-of-Band Git Authentication on the External Backup Host
# GIT_AUTH_MODE: "ssh" (deploy key) or "https" (fine-grained PAT).
GIT_AUTH_MODE="ssh"
# SSH mode: generate a dedicated read-only deploy key on the backup host:
#   ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519_compnova_backup -N ""
#   # add the .pub file to GitHub as a (read-only) deploy key per repository
GIT_SSH_KEY_FILE="/root/.ssh/id_ed25519_compnova_backup"
GIT_SSH_KNOWN_HOSTS_FILE="/root/.ssh/known_hosts"
# "accept-new" pins unknown github.com host keys on first connect; "yes" is stricter.
# Seed manually with: ssh-keyscan -t ed25519 github.com >> /root/.ssh/known_hosts
GIT_SSH_STRICT_HOST_CHECKING="accept-new"
# HTTPS mode only: fine-grained PAT with read-only Contents permission on every
# repo in GITHUB_REPO_LIST. Never commit a real token; provide via secrets/env.
GITHUB_BACKUP_PAT=""
